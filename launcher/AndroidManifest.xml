<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="home.friday.tv"
    android:versionCode="16"
    android:versionName="4.0">

    <!-- Only Continue watching artwork, from each publishing app's own image hosts. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Granted over adb: lets Haven read other apps' Continue watching (Watch Next) rows. -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Android 11+ package visibility: let the launcher see every launchable app. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- usesCleartextTraffic is for the Mac's wallpaper service, plain HTTP on the LAN.
         Everything fetched from the internet is https by policy: see ArtworkPolicy for app
         artwork and the wallpaper module's Previews for Workshop previews. -->
    <application
        android:label="Friday Home"
        android:icon="@drawable/ic_launcher"
        android:banner="@drawable/banner"
        android:theme="@style/Theme.Haven"
        android:usesCleartextTraffic="true"
        android:allowBackup="false">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:resizeableActivity="false"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|smallestScreenSize|screenLayout|uiMode|density"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter android:priority="1">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".HomeKeyService"
            android:directBootAware="true"
            android:exported="true"
            android:label="@string/home_key_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_key_service" />
        </service>
        <service
            android:name=".HavenDream"
            android:exported="true"
            android:label="Friday wallpaper"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
        <!-- The Mac picks a wallpaper through this; android.permission.DUMP keeps it to adb. -->
        <receiver
            android:name=".SetWallpaper"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <activity android:name=".BootProbeActivity" android:exported="false"
            android:excludeFromRecents="true" android:noHistory="true" android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
